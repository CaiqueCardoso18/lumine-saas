generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTH & USERS
// ============================================================

enum UserRole {
  OWNER
  EMPLOYEE
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String
  role         UserRole  @default(EMPLOYEE)
  active       Boolean   @default(true)
  permissions  Json      @default("[]") // ex: ["view_orders","view_cost_price","manage_products","view_analytics","upload"]
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  sales              Sale[]
  auditLogs          AuditLog[]
  inventorySessions  InventorySession[]
  stockMovements     StockMovement[]

  @@map("users")
}

// ============================================================
// PRODUCTS & INVENTORY
// ============================================================

model Category {
  id            String        @id @default(cuid())
  name          String        @unique
  slug          String        @unique
  icon          String?
  sortOrder     Int           @default(0) @map("sort_order")
  createdAt     DateTime      @default(now()) @map("created_at")

  subcategories Subcategory[]
  products      Product[]

  @@map("categories")
}

model Subcategory {
  id         String    @id @default(cuid())
  name       String
  slug       String
  categoryId String    @map("category_id")
  sortOrder  Int       @default(0) @map("sort_order")
  createdAt  DateTime  @default(now()) @map("created_at")

  category   Category  @relation(fields: [categoryId], references: [id])
  products   Product[]

  @@unique([categoryId, slug])
  @@map("subcategories")
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

model Product {
  id            String        @id @default(cuid())
  sku           String        @unique
  name          String
  description      String?    // descrição completa
  shortDescription String?    @map("short_description") // resumo curto, para listagem e etiqueta
  categoryId    String        @map("category_id")
  subcategoryId String?       @map("subcategory_id")
  brand         String?
  size          String?
  color         String?
  audience      Audience?     // Adulto / Infantil — opcional (acessórios não se aplicam)
  costPrice     Decimal       @map("cost_price") @db.Decimal(10, 2)
  salePrice     Decimal       @map("sale_price") @db.Decimal(10, 2)
  quantity      Int           @default(0)
  minStock      Int           @default(5) @map("min_stock")
  imageUrl      String?       @map("image_url")
  status        ProductStatus @default(ACTIVE)
  barcode       String?
  /// Concatenação normalizada (sem acento, minúscula) de sku/nome/marca/tamanho/
  /// cor/barcode/descrição curta/categoria/público. Usada pela busca multi-termo.
  /// Mantida por buildSearchText() em toda criação e atualização.
  searchText    String?       @map("search_text")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  deletedAt     DateTime?     @map("deleted_at")

  category      Category      @relation(fields: [categoryId], references: [id])
  subcategory   Subcategory?  @relation(fields: [subcategoryId], references: [id])
  saleItems        SaleItem[]
  orderItems       OrderItem[]
  auditLogs        AuditLog[]
  inventoryCounts  InventoryCount[]
  stockMovements   StockMovement[]

  @@index([sku])
  @@index([name])
  @@index([categoryId])
  @@index([status])
  @@index([deletedAt])
  @@index([audience])
  @@index([brand])
  @@index([searchText])
  @@map("products")
}

enum Audience {
  ADULTO
  INFANTIL
}

// ============================================================
// SALES (PDV)
// ============================================================

/// Frequência de vencimento das parcelas do crediário.
/// A loja tem cliente que paga de 15 em 15 dias, não só no mesmo dia do mês.
enum InstallmentFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum PaymentMethod {
  CASH
  PIX
  DEBIT_CARD
  CREDIT_CARD
  CREDIARIO
  MIXED
}

enum SaleStatus {
  COMPLETED
  CANCELLED
}

model Sale {
  id              String        @id @default(cuid())
  saleNumber      Int           @unique @default(autoincrement()) @map("sale_number")
  userId          String        @map("user_id")
  customerId      String?       @map("customer_id") // opcional — venda de balcão não exige cliente
  subtotal        Decimal       @db.Decimal(10, 2)
  discountAmount  Decimal       @default(0) @map("discount_amount") @db.Decimal(10, 2)
  discountPercent Decimal?      @map("discount_percent") @db.Decimal(5, 2)
  total           Decimal       @db.Decimal(10, 2)
  // Taxa da maquininha descontada do total e o que sobra de fato.
  // Guardado na venda porque a tabela de taxas muda com o tempo e o
  // histórico precisa refletir o que foi cobrado NAQUELE dia.
  feeAmount       Decimal       @default(0) @map("fee_amount") @db.Decimal(10, 2)
  netTotal        Decimal       @default(0) @map("net_total") @db.Decimal(10, 2)
  paymentMethod   PaymentMethod @map("payment_method")
  status          SaleStatus    @default(COMPLETED)
  notes           String?
  // Crediário: entrada paga na hora e cadência das parcelas.
  // A entrada NÃO vira parcela — entra como pagamento normal, porque
  // também precisa aparecer no caixa do dia.
  downPayment     Decimal       @default(0) @map("down_payment") @db.Decimal(10, 2)
  installmentFrequency InstallmentFrequency? @map("installment_frequency")
  cancelledAt     DateTime?     @map("cancelled_at")
  cancelReason    String?       @map("cancel_reason")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  user            User          @relation(fields: [userId], references: [id])
  customer        Customer?     @relation(fields: [customerId], references: [id])
  items           SaleItem[]
  payments        SalePayment[]
  installments    Installment[]

  @@index([createdAt])
  @@index([status])
  @@index([paymentMethod])
  @@index([customerId])
  @@map("sales")
}

// ============================================================
// CLIENTES & CREDIÁRIO
// ============================================================

model Customer {
  id         String    @id @default(cuid())
  name       String
  phone      String?
  email      String?
  document   String?   // CPF
  address    String?
  notes      String?
  active     Boolean   @default(true)
  /// Nome/telefone/CPF normalizados para a busca do PDV
  searchText String?   @map("search_text")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  sales        Sale[]
  installments Installment[]

  @@index([name])
  @@index([searchText])
  @@index([deletedAt])
  @@map("customers")
}

enum InstallmentStatus {
  PENDING
  PAID
  CANCELLED
  /// Substituída por uma parcela nova numa renegociação. Fica no histórico
  /// apontando para a substituta em vez de sumir.
  RENEGOTIATED
}

/// Parcela de crediário. Gerada na venda quando o pagamento é CREDIARIO
/// (ou quando uma das formas do pagamento misto é crediário).
model Installment {
  id          String            @id @default(cuid())
  saleId      String            @map("sale_id")
  customerId  String            @map("customer_id")
  number      Int               // 1, 2, 3...
  totalCount  Int               @map("total_count") // total de parcelas da venda
  amount      Decimal           @db.Decimal(10, 2)
  dueDate     DateTime          @map("due_date")
  status      InstallmentStatus @default(PENDING)
  paidAt      DateTime?         @map("paid_at")
  paidAmount  Decimal?          @map("paid_amount") @db.Decimal(10, 2)
  paidMethod  PaymentMethod?    @map("paid_method")
  notes       String?
  // Renegociação: a parcela antiga vira RENEGOTIATED e aponta para a nova,
  // em vez de sumir. Assim o histórico de cobrança não some do nada.
  renegotiatedIntoId String?    @map("renegotiated_into_id")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  sale        Sale              @relation(fields: [saleId], references: [id])
  customer    Customer          @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([status])
  @@index([dueDate])
  @@index([saleId])
  @@map("installments")
}

model SaleItem {
  id          String   @id @default(cuid())
  saleId      String   @map("sale_id")
  productId   String   @map("product_id")
  productName String   @map("product_name")
  productSku  String   @map("product_sku")
  quantity    Int
  unitPrice   Decimal  @map("unit_price") @db.Decimal(10, 2)
  costPrice   Decimal  @map("cost_price") @db.Decimal(10, 2)
  discount    Decimal  @default(0) @db.Decimal(10, 2)
  total       Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  sale        Sale     @relation(fields: [saleId], references: [id])
  product     Product  @relation(fields: [productId], references: [id])

  @@map("sale_items")
}

model SalePayment {
  id           String        @id @default(cuid())
  saleId       String        @map("sale_id")
  method       PaymentMethod
  amount       Decimal       @db.Decimal(10, 2)
  installments Int           @default(1) // parcelas (só relevante p/ CREDIT_CARD)
  // Taxa aplicada a ESTA forma. No misto cada cartão tem a sua.
  feePercent   Decimal       @default(0) @map("fee_percent") @db.Decimal(5, 2)
  feeAmount    Decimal       @default(0) @map("fee_amount") @db.Decimal(10, 2)
  netAmount    Decimal       @default(0) @map("net_amount") @db.Decimal(10, 2)
  createdAt    DateTime      @default(now()) @map("created_at")

  sale      Sale          @relation(fields: [saleId], references: [id])

  @@map("sale_payments")
}

// ============================================================
// ORDERS (REPOSIÇÃO / COMPRAS)
// ============================================================

enum OrderStatus {
  DRAFT
  SENT
  RECEIVED
  CHECKED
  CANCELLED
}

model Supplier {
  id          String   @id @default(cuid())
  name        String
  contactName String?  @map("contact_name")
  phone       String?
  email       String?
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  payables    Payable[]
  orders      Order[]

  @@map("suppliers")
}

model Order {
  id          String      @id @default(cuid())
  orderNumber Int         @unique @default(autoincrement()) @map("order_number")
  supplierId  String?     @map("supplier_id")
  status      OrderStatus @default(DRAFT)
  totalCost   Decimal     @default(0) @map("total_cost") @db.Decimal(10, 2)
  notes       String?
  sentAt      DateTime?   @map("sent_at")
  receivedAt  DateTime?   @map("received_at")
  checkedAt   DateTime?   @map("checked_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  supplier    Supplier?   @relation(fields: [supplierId], references: [id])
  items       OrderItem[]

  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id               String   @id @default(cuid())
  orderId          String   @map("order_id")
  productId        String   @map("product_id")
  quantityOrdered  Int      @map("quantity_ordered")
  quantityReceived Int?     @map("quantity_received")
  unitCost         Decimal  @map("unit_cost") @db.Decimal(10, 2)
  createdAt        DateTime @default(now()) @map("created_at")

  order            Order    @relation(fields: [orderId], references: [id])
  product          Product  @relation(fields: [productId], references: [id])

  @@map("order_items")
}

// ============================================================
// INVENTORY (Contagem Física + Movimentações de Estoque)
// ============================================================

enum InventorySessionStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model InventorySession {
  id            String                 @id @default(cuid())
  name          String                 // ex: "Inventário Mensal Abril 2026"
  userId        String                 @map("user_id")
  status        InventorySessionStatus @default(IN_PROGRESS)
  notes         String?
  totalProducts Int                    @default(0) @map("total_products")
  matchedCount  Int                    @default(0) @map("matched_count")   // contagens que bateram
  divergedCount Int                    @default(0) @map("diverged_count")  // contagens com divergência
  appliedAt     DateTime?              @map("applied_at")                  // quando os ajustes foram aplicados
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  user          User                   @relation(fields: [userId], references: [id])
  counts        InventoryCount[]

  @@index([status])
  @@index([createdAt])
  @@map("inventory_sessions")
}

model InventoryCount {
  id               String           @id @default(cuid())
  sessionId        String           @map("session_id")
  productId        String           @map("product_id")
  systemQuantity   Int              @map("system_quantity")   // qty no sistema no momento da contagem
  countedQuantity  Int              @map("counted_quantity")  // qty contada fisicamente
  difference       Int              @default(0)               // counted - system (calculado)
  notes            String?
  createdAt        DateTime         @default(now()) @map("created_at")

  session          InventorySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  product          Product          @relation(fields: [productId], references: [id])

  @@unique([sessionId, productId])
  @@map("inventory_counts")
}

enum MovementType {
  ADJUSTMENT      // ajuste manual genérico
  LOSS            // perda / avaria
  DAMAGE          // dano
  RETURN          // devolução de cliente (não via venda)
  TRANSFER_IN     // entrada por transferência
  TRANSFER_OUT    // saída por transferência
  INVENTORY_ADJUSTMENT  // ajuste vindo de sessão de inventário
  OTHER
}

model StockMovement {
  id            String       @id @default(cuid())
  productId     String       @map("product_id")
  userId        String       @map("user_id")
  type          MovementType
  quantity      Int          // positivo = entrada, negativo = saída
  previousStock Int          @map("previous_stock")
  newStock      Int          @map("new_stock")
  reason        String       // motivo obrigatório
  reference     String?      // referência livre (ex: "Sessão Inventário #xyz", "NF 1234")
  createdAt     DateTime     @default(now()) @map("created_at")

  product       Product      @relation(fields: [productId], references: [id])
  user          User         @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([type])
  @@index([createdAt])
  @@map("stock_movements")
}

// ============================================================
// UPLOAD / IMPORT
// ============================================================

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Import {
  id           String       @id @default(cuid())
  fileName     String       @map("file_name")
  totalRows    Int          @map("total_rows")
  createdCount Int          @default(0) @map("created_count")
  updatedCount Int          @default(0) @map("updated_count")
  errorCount   Int          @default(0) @map("error_count")
  status       ImportStatus @default(PENDING)
  errors       Json?
  createdAt    DateTime     @default(now()) @map("created_at")
  completedAt  DateTime?    @map("completed_at")

  @@index([createdAt])
  @@map("imports")
}

// ============================================================
// AUDIT LOG
// ============================================================

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STOCK_CHANGE
  PRICE_CHANGE
  BULK_UPDATE
  IMPORT
  SALE
  SALE_CANCEL
  ORDER_STATUS_CHANGE
  INVENTORY_ADJUST
  STOCK_MOVEMENT
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String?     @map("user_id")
  productId  String?     @map("product_id")
  action     AuditAction
  entityType String      @map("entity_type")
  entityId   String      @map("entity_id")
  oldValue   Json?       @map("old_value")
  newValue   Json?       @map("new_value")
  metadata   Json?
  createdAt  DateTime    @default(now()) @map("created_at")

  user       User?       @relation(fields: [userId], references: [id])
  product    Product?    @relation(fields: [productId], references: [id])

  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@index([userId])
  @@map("audit_logs")
}

// ============================================================
// SETTINGS
// ============================================================

/// Tabela de taxas da maquininha.
///
/// Uma linha por (forma, nº de parcelas): débito tem uma só, crédito tem uma
/// por parcela, porque a operadora cobra mais conforme parcela. Sem linha
/// cadastrada a taxa é zero — assim nada quebra antes de a loja preencher.
model CardFee {
  id           String        @id @default(cuid())
  method       PaymentMethod
  installments Int           @default(1)
  feePercent   Decimal       @map("fee_percent") @db.Decimal(5, 2)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@unique([method, installments])
  @@map("card_fees")
}

enum PayableStatus {
  PENDING
  PAID
  CANCELLED
}

/// Conta a pagar: aluguel, fornecedor, energia, o que a loja deve.
///
/// Os pedidos de reposição não servem para isso — eles não têm vencimento
/// nem controle de pagamento, só o fluxo de recebimento de mercadoria.
model Payable {
  id          String        @id @default(cuid())
  description String
  /// Rótulo livre (Aluguel, Fornecedor, Energia...) para agrupar no relatório
  category    String?
  supplierId  String?       @map("supplier_id")
  amount      Decimal       @db.Decimal(10, 2)
  dueDate     DateTime      @map("due_date")
  status      PayableStatus @default(PENDING)
  paidAt      DateTime?     @map("paid_at")
  paidAmount  Decimal?      @map("paid_amount") @db.Decimal(10, 2)
  notes       String?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  supplier    Supplier?     @relation(fields: [supplierId], references: [id])

  @@index([dueDate])
  @@index([status])
  @@map("payables")
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}
